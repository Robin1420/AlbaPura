{
  "name": "alba-pura-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "routes": "node scripts/gen-routes.mjs",
    "dev": "npm run routes && wrangler dev",
    "deploy": "npm run routes && wrangler deploy",
    "typecheck": "npm run routes && tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate:remote": "wrangler d1 migrations apply alba-pura-db --remote",
    "db:migrate:local": "wrangler d1 migrations apply alba-pura-db --local"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261103.1",
    "@libsql/client": "^0.18.0",
    "@types/node": "^20",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "wrangler": "^4.157.0"
  }
}
