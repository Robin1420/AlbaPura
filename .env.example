# URL pública del sitio (para volver desde Webpay y armar enlaces de correo)
APP_URL=http://localhost:3000

# Base de datos. Local: archivo SQLite. Producción: Turso (libsql://...) con DATABASE_AUTH_TOKEN
DATABASE_URL=file:./data/alba.db
DATABASE_AUTH_TOKEN=

# Webpay Plus es de Transbank (Chile) y no aplica en Perú: no hace falta definirlo. Se conserva por si se reutiliza la integración.
# Webpay Plus. Sin estas variables se usa el ambiente de integración (pruebas) de Transbank.
TBK_COMMERCE_CODE=
TBK_API_KEY=

# Correo (Resend). Sin RESEND_API_KEY los correos se imprimen en la consola del servidor.
RESEND_API_KEY=
EMAIL_FROM=Alba Pura <pedidos@tudominio.pe>
# Correo que recibe los mensajes del formulario de contacto (sin él, quedan guardados en /admin/mensajes)
CONTACT_TO=

# Datos bancarios que se muestran al elegir transferencia
BANK_INFO=Yape o Plin al 9XX XXX XXX a nombre de Yuleisi Cucho. Indica tu número de pedido.

# Pon 1 cuando subas public/video/hero.mp4. Sin video, el inicio muestra el texto de inmediato (más rápido).
NEXT_PUBLIC_HERO_VIDEO=

# Datos de contacto públicos (se muestran en la página de contacto solo si los defines)
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_WHATSAPP=
NEXT_PUBLIC_INSTAGRAM=
